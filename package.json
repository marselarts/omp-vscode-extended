{
  "name": "omp-chat-timer",
  "displayName": "OMP Chat Timer",
  "description": "Copilot/Cursor-style chat sidebar for OMP (omp) with agent runtime timer",
  "repository": {
    "type": "git",
    "url": "https://github.com/Chakyiu/omp-vscode"
  },
  "version": "0.1.0",
  "publisher": "ChakyiuLI",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Other"
  ],
  "keywords": [
    "omp",
    "oh-my-pi",
    "ai",
    "chat",
    "coding-agent"
  ],
  "activationEvents": [
    "onView:ompTimer.sidebar",
    "onCommand:ompTimer.open",
    "onCommand:ompTimer.newChat",
    "onCommand:ompTimer.sendSelection",
    "onCommand:ompTimer.attachFiles",
    "onCommand:ompTimer.attachFolder",
    "onCommand:ompTimer.attachMenu",
    "onCommand:ompTimer.attachExplorer",
    "onCommand:ompTimer.attachTerminal"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ompTimer",
          "title": "OMP",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "ompTimer": [
        {
          "type": "webview",
          "id": "ompTimer.sidebar",
          "name": "Chat"
        }
      ]
    },
    "commands": [
      {
        "command": "ompTimer.open",
        "title": "OMP Timer: Open Chat",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "ompTimer.newChat",
        "title": "OMP Timer: New Chat",
        "icon": "$(add)"
      },
      {
        "command": "ompTimer.stop",
        "title": "OMP Timer: Stop Generation",
        "icon": "$(debug-stop)"
      },
      {
        "command": "ompTimer.sendSelection",
        "title": "OMP Timer: Send Selection to Chat"
      },
      {
        "command": "ompTimer.attachCurrentFile",
        "title": "OMP Timer: Attach Current File"
      },
      {
        "command": "ompTimer.restartSession",
        "title": "OMP Timer: Restart Session"
      },
      {
        "command": "ompTimer.attachFiles",
        "title": "OMP Timer: Attach Files",
        "icon": "$(attach)"
      },
      {
        "command": "ompTimer.attachFolder",
        "title": "OMP Timer: Attach Folder",
        "icon": "$(folder)"
      },
      {
        "command": "ompTimer.attachMenu",
        "title": "OMP Timer: Attach…",
        "icon": "$(attach)"
      },
      {
        "command": "ompTimer.attachExplorer",
        "title": "OMP Timer: Attach to Chat",
        "icon": "$(attach)"
      },
      {
        "command": "ompTimer.attachTerminal",
        "title": "OMP Timer: Attach Terminal Output",
        "icon": "$(terminal)"
      },
      {
        "command": "ompTimer.showToolLog",
        "title": "OMP Timer: Show File Touch Log",
        "icon": "$(output)"
      },
      {
        "command": "ompTimer.showErrorLog",
        "title": "OMP Timer: Show Error Log",
        "icon": "$(output)"
      },
      {
        "command": "ompTimer.askAboutSession",
        "title": "OMP Timer: Ask About This Session",
        "icon": "$(comment-discussion)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "ompTimer.askAboutSession",
          "when": "view == ompTimer.sidebar",
          "group": "navigation@0"
        },
        {
          "command": "ompTimer.newChat",
          "when": "view == ompTimer.sidebar",
          "group": "navigation@1"
        },
        {
          "command": "ompTimer.stop",
          "when": "view == ompTimer.sidebar",
          "group": "navigation@2"
        },
        {
          "command": "ompTimer.restartSession",
          "when": "view == ompTimer.sidebar",
          "group": "navigation@3"
        },
        {
          "command": "ompTimer.attachMenu",
          "when": "view == ompTimer.sidebar",
          "group": "navigation@0"
        }
      ],
      "editor/context": [
        {
          "command": "ompTimer.sendSelection",
          "when": "editorHasSelection",
          "group": "ompTimer@1"
        },
        {
          "command": "ompTimer.attachCurrentFile",
          "group": "ompTimer@2"
        }
      ],
      "explorer/context": [
        {
          "command": "ompTimer.attachExplorer",
          "group": "ompTimer@1"
        }
      ],
      "terminal/context": [
        {
          "command": "ompTimer.attachTerminal",
          "group": "ompTimer@1"
        }
      ]
    },
    "configuration": {
      "title": "OMP Chat Timer",
      "properties": {
        "ompTimer.ompPath": {
          "type": "string",
          "default": "omp",
          "description": "Path to the omp executable."
        },
        "ompTimer.model": {
          "type": "string",
          "default": "",
          "description": "Optional model override (fuzzy match, e.g. opus, gpt-5.2)."
        },
        "ompTimer.thinking": {
          "type": "string",
          "enum": [
            "",
            "off",
            "minimal",
            "low",
            "medium",
            "high",
            "xhigh",
            "max",
            "auto"
          ],
          "default": "",
          "description": "Optional thinking level passed to omp."
        },
        "ompTimer.approvalMode": {
          "type": "string",
          "enum": [
            "",
            "always-ask",
            "write",
            "yolo"
          ],
          "default": "",
          "description": "Optional tools.approvalMode override for this session."
        },
        "ompTimer.autoApprove": {
          "type": "boolean",
          "default": false,
          "description": "Pass --auto-approve to omp (skip approval prompts)."
        },
        "ompTimer.continueLastSession": {
          "type": "boolean",
          "default": true,
          "description": "Restore all open omp chat tabs/sessions when the chat bridge starts (survives VS Code restarts/kills). Disable to always start a blank session."
        },
        "ompTimer.autoTitle": {
          "type": "boolean",
          "default": true,
          "description": "Let omp generate a short session title after the first message (uses the tiny/smol title model). Shows on chat tabs and in history. Changing this offers a restart so open chats pick it up."
        },
        "ompTimer.extraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra CLI args appended when spawning omp --mode rpc."
        },
        "ompTimer.mode": {
          "type": "string",
          "enum": [
            "Agent",
            "Ask",
            "Plan"
          ],
          "default": "Agent",
          "description": "Chat mode shown in the Cursor-style composer."
        },
        "ompTimer.displayName": {
          "type": "string",
          "default": "",
          "description": "Optional name used in the greeting (e.g. How can I help you, Alex?)."
        },
        "ompTimer.showThinking": {
          "type": "boolean",
          "default": true,
          "description": "Show model thinking blocks in the chat UI."
        },
        "ompTimer.logFileTouches": {
          "type": "boolean",
          "default": true,
          "description": "Log edit/write/delete tool calls and touched file paths to the \"OMP File Touches\" output channel."
        },
        "ompTimer.askModel": {
          "type": "string",
          "default": "",
          "description": "Model for the parallel \"Ask about this session\" chat (fuzzy match). Empty = same as ompTimer.model / the session's default. The ask runs in its own omp process and never delays the session."
        }
      }
    },
    "keybindings": [
      {
        "command": "ompTimer.open",
        "key": "ctrl+shift+;",
        "mac": "cmd+shift+;"
      },
      {
        "command": "ompTimer.sendSelection",
        "key": "ctrl+shift+'",
        "mac": "cmd+shift+'",
        "when": "editorTextFocus && editorHasSelection"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "compile": "tsc -p tsconfig.json --noEmit",
    "package": "vsce package --no-dependencies --allow-missing-repository",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@types/node": "^22.13.10",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.3.2",
    "esbuild": "^0.25.1",
    "typescript": "^5.8.2"
  }
}
